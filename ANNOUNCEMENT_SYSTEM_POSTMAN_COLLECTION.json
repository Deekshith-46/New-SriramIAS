								{
									"key": "description",
									"value": "Updated description text",
									"type": "text"
								},
								{
									"key": "announcementType",
									"value": "important",
									"type": "text"
								},
								{
									"key": "thumbnail",
									"type": "file",
									"src": [],
									"disabled": true
								},
								{
									"key": "pdf",
									"type": "file",
									"src": [],
									"disabled": true
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/announcements/{{announcementId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements",
								"{{announcementId}}"
							]
						},
						"description": "Update an existing announcement with new data and optional file uploads."
					},
					"response": []
				},
				{
					"name": "Delete Announcement Permanently",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/announcements/{{announcementId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements",
								"{{announcementId}}"
							]
						},
						"description": "Permanently delete an announcement from the database."
					},
					"response": []
				}
			]
		},
		{
