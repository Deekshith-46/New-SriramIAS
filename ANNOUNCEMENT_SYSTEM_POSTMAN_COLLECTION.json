							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements",
								"{{announcementId}}",
								"read"
							]
						},
						"description": "Mark a specific announcement as read by the student."
					},
					"response": []
				},
				{
					"name": "Get Unread Count",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}",
								"type": "text"
							}
