{
	"info": {
		"_postman_id": "announcement-system-sriram-ias",
		"name": "Announcement System - Sriram IAS",
		"description": "Complete API collection for the Course-based Announcement System",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "YOUR_ADMIN_JWT_TOKEN",
			"type": "string"
		},
		{
			"key": "studentToken",
			"value": "YOUR_STUDENT_JWT_TOKEN",
			"type": "string"
		},
		{
			"key": "announcementId",
			"value": "ANNOUNCEMENT_ID_HERE",
			"type": "string"
		},
		{
			"key": "courseId",
			"value": "COURSE_ID_HERE",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "👨‍💼 Admin APIs",
			"item": [
				{
					"name": "Create Announcement",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "title",
									"value": "Anubuthi III Results Announced",
									"type": "text"
								},
								{
									"key": "description",
									"value": "Results officially announced. Check your dashboard for details.",
									"type": "text"
								},
								{
									"key": "courseId",
									"value": "{{courseId}}",
									"type": "text"
								},
								{
									"key": "announcementType",
									"value": "result",
									"type": "text"
								},
								{
									"key": "categoryId",
									"value": "",
									"type": "text",
									"disabled": true
								},
								{
									"key": "centerId",
									"value": "",
									"type": "text",
									"disabled": true
								},
								{
									"key": "publishedAt",
									"value": "",
									"type": "text",
									"disabled": true
								},
								{
									"key": "thumbnail",
									"type": "file",
									"src": [],
									"disabled": true
								},
								{
									"key": "pdf",
									"type": "file",
									"src": [],
									"disabled": true
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/announcements",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements"
							]
						},
						"description": "Create a new announcement with optional thumbnail and PDF attachments."
					},
					"response": []
				},
				{
					"name": "Get All Announcements",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/announcements?page=1&limit=20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements"
							],
							"query": [
								{
									"key": "courseId",
									"value": "",
									"disabled": true
								},
								{
									"key": "centerId",
									"value": "",
									"disabled": true
								},
								{
									"key": "categoryId",
									"value": "",
									"disabled": true
								},
								{
									"key": "announcementType",
									"value": "",
									"description": "general, exam, result, important",
									"disabled": true
								},
								{
									"key": "isActive",
									"value": "true",
									"disabled": true
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "Retrieve all announcements with filtering and pagination."
					},
					"response": []
				},
				{
					"name": "Get Single Announcement",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/announcements/{{announcementId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"announcements",
								"{{announcementId}}"
							]
						},
						"description": "Retrieve details of a specific announcement."
					},
					"response": []
				},
				{
					"name": "Update Announcement",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
