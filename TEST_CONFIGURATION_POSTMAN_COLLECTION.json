          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionName\": \"English Comprehension\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{BASE_URL}}/api/test-configuration/sections"
          }
        },
        {
          "name": "GET List (search + status + sort A-Z)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/test-configuration/sections?page=1&limit=10&search=&status=ACTIVE&sortPreset=sectionName_az",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "test-configuration", "sections"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" },
                { "key": "sortPreset", "value": "sectionName_az" }
              ]
            }
          }
        },
        {
          "name": "GET List - Section Name Z-A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/test-configuration/sections?sortPreset=sectionName_za",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "test-configuration", "sections"],
              "query": [{ "key": "sortPreset", "value": "sectionName_za" }]
            }
          }
        },
        {
          "name": "GET List - Created On Oldest",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/test-configuration/sections?sortPreset=createdOn_oldest",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "test-configuration", "sections"],
              "query": [{ "key": "sortPreset", "value": "createdOn_oldest" }]
            }
          }
        },
        {
          "name": "GET Dropdown (Active)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": "{{BASE_URL}}/api/test-configuration/sections/dropdown"
          }
        },
        {
          "name": "GET View Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": "{{BASE_URL}}/api/test-configuration/sections/{{sectionId}}"
          }
        },
        {
          "name": "PUT Edit Section",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionName\": \"Reasoning Section\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{BASE_URL}}/api/test-configuration/sections/{{sectionId}}"
          }
        },
        {
          "name": "PATCH Update Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": "{{BASE_URL}}/api/test-configuration/sections/status/{{sectionId}}"
          }
        },
        {
          "name": "DELETE Section",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": "{{BASE_URL}}/api/test-configuration/sections/{{sectionId}}"
          }
        }
      ]
    },
    {
      "name": "3. Language Settings",
      "item": [
        {
          "name": "POST Create Language",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?._id) pm.collectionVariables.set('languageId', j.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"languageName\": \"English\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{BASE_URL}}/api/test-configuration/languages"
          }
        },
        {
          "name": "GET List (search + status)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/test-configuration/languages?page=1&limit=10&search=&status=ACTIVE",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "test-configuration", "languages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "GET Dropdown (Active)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": "{{BASE_URL}}/api/test-configuration/languages/dropdown"
          }
        },
        {
          "name": "GET View Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" }],
            "url": "{{BASE_URL}}/api/test-configuration/languages/{{languageId}}"
          }
        },
        {
          "name": "PUT Edit Language",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SuperAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
