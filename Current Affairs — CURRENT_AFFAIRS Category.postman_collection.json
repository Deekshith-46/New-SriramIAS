    {
      "name": "3. Create Paper (Save button)",
      "item": [
        {
          "name": "Create Daily Practice Paper + Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.paper && json.data.paper._id) {",
                  "    pm.collectionVariables.set('currentAffairId', json.data.paper._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mainsCategory\": \"Prelims\",\n  \"paperName\": \"Daily Practice Set 1\",\n  \"year\": 2026,\n  \"month\": \"June\",\n  \"date\": \"2026-06-01\",\n  \"sectionFrom\": 1,\n  \"sectionTo\": 3,\n  \"description\": \"June daily practice questions\",\n  \"questions\": [\n    {\n      \"questionNumber\": 1,\n      \"question\": \"What is the capital of India?\",\n      \"optionA\": \"Mumbai\",\n      \"optionB\": \"New Delhi\",\n      \"optionC\": \"Kolkata\",\n      \"optionD\": \"Chennai\",\n      \"correctAnswer\": \"B\",\n      \"explanation\": \"New Delhi is the capital of India\"\n    },\n    {\n      \"questionNumber\": 2,\n      \"question\": \"Which river is the longest in India?\",\n      \"optionA\": \"Yamuna\",\n      \"optionB\": \"Godavari\",\n      \"optionC\": \"Ganga\",\n      \"optionD\": \"Narmada\",\n      \"correctAnswer\": \"C\",\n      \"explanation\": \"Ganga is the longest river in India\"\n    },\n    {\n      \"questionNumber\": 3,\n      \"question\": \"When did India get independence?\",\n      \"optionA\": \"1945\",\n      \"optionB\": \"1947\",\n      \"optionC\": \"1950\",\n      \"optionD\": \"1952\",\n      \"correctAnswer\": \"B\",\n      \"explanation\": \"India got independence on 15 August 1947\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/current-affairs/daily-practice",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "current-affairs",
                "daily-practice"
              ]
            },
            "description": "Matches the UI **Save** flow with section From=1, To=3 and 3 manual questions."
          },
          "response": []
        }
      ]
