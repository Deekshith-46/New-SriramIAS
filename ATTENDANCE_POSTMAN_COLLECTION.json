{
  "info": {
    "name": "LMS Attendance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "studentToken", "value": "" },
    { "key": "parentToken", "value": "" },
    { "key": "studentUserId", "value": "" }
  ],
  "item": [
    {
      "name": "Student",
      "item": [
        {
          "name": "Check-In",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/attendance/check-in"
          }
        },
        {
          "name": "Check-Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/check-out"
          }
        },
        {
          "name": "Apply Leave",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Sick Leave\"\n}" },
            "url": "{{baseUrl}}/api/attendance/leave"
          }
        },
        {
          "name": "Today Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/today"
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/stats"
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/list?month=5&year=2026"
          }
        }
      ]
    },
    {
      "name": "Parent",
      "item": [
        {
          "name": "Child Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/stats?studentId={{studentUserId}}"
          }
        },
        {
          "name": "Child List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
            "url": "{{baseUrl}}/api/attendance/list?studentId={{studentUserId}}"
          }
        }
      ]
    }
  ]
}
